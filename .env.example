NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Digits only with country code, no + (e.g. 91XXXXXXXXXX). Used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Canonical origin for sitemap / metadata, e.g. https://www.example.in. Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=
# "true" lets search engines index the site. Anything else (default): robots.txt disallows all + noindex on every page.
NEXT_PUBLIC_ALLOW_INDEXING=false

# BUSY SQL Server — direct read-only pull (scripts/busy-sql/discover.mjs).
# Separate mechanism from the header-based BUSY Web Service relay; read-only login only.
BUSY_SQL_SERVER=192.168.1.10
BUSY_SQL_PORT=1433
BUSY_SQL_DATABASE=YOUR_BUSY_DB
BUSY_SQL_READONLY_USER=busy_readonly
BUSY_SQL_READONLY_PASSWORD=YOUR_READONLY_PASSWORD
# Legacy on-prem instances usually need TLS off; set to true if the server requires it.
BUSY_SQL_ENCRYPT=false

# BUSY Web Service — local HTTP listener embedded in the BUSY desktop app (scripts/busy-ws-ping.mjs).
# BUSY must be running with the target company logged in. Auth is plaintext headers on every call.
BUSY_HOST=localhost
BUSY_PORT=981
BUSY_USERNAME=YOUR_BUSY_OPERATOR
BUSY_PASSWORD=YOUR_BUSY_OPERATOR_PASSWORD
# Every BUSY query is refused unless DB_NAME() equals this (company + financial year, e.g. BusyComp0003_db12026).
BUSY_EXPECTED_DB=BusyCompNNNN_db1YYYY

# BUSY → Supabase sync (scripts/busy-sync). Server-side only: never give any of these a NEXT_PUBLIC_ prefix.
# Prices / stock are stored but hidden on the site until a person confirms them on the BUSY screen. Only "true" enables.
PRICE_VERIFIED=false
STOCK_VERIFIED=false
# Live writes need BOTH the --live flag and this set to exactly "true". Keep false everywhere except the sync server.
ALLOW_LIVE_WRITE=false
# Needed for --live only. The service role key bypasses RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional: pinged (GET) after each successful live run. Leave empty to disable.
HEALTHCHECK_URL=
# Where --dry-run writes its output and local state (gitignored). Relative paths resolve from the repo root.
SYNC_DATA_DIR=local-data
