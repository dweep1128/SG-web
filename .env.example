NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Digits only with country code, no + (e.g. 91XXXXXXXXXX). Used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Canonical origin for sitemap / metadata, e.g. https://www.example.in. Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=
# "true" lets search engines index the site. Anything else (default): robots.txt disallows all + noindex on every page.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" = only products with BOTH a staff display name and a photo show on the public site. Default false. Server-side (Vercel).
REQUIRE_DISPLAY_NAME_AND_PHOTO=false

# SK-image admin portal photo uploads (Cloudinary). The API key/secret are server-only: never prefix them with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Everything below is for the SYNC SERVER only (the cloud box running n8n). Never put these on Vercel. ───

# BUSY SQL Server on the shop PC, reached over Tailscale. The sync uses ONLY this read-only login.
BUSY_SQL_SERVER=100.x.y.z
BUSY_SQL_PORT=1433
BUSY_SQL_DATABASE=BusyComp0003_db12026
BUSY_SQL_READONLY_USER=webapp_readonly
BUSY_SQL_READONLY_PASSWORD=YOUR_READONLY_PASSWORD
# Legacy on-prem instances usually need TLS off (traffic is inside the Tailscale tunnel); true if the server requires it.
BUSY_SQL_ENCRYPT=false
# Every run is refused unless DB_NAME() equals this exactly. S.K. TRADERS = Comp0003. Comp0001 is a DIFFERENT company.
BUSY_EXPECTED_DB=BusyComp0003_db12026

# Prices / stock are stored but hidden on the site until a person confirms them on the BUSY screen. Only "true" enables.
PRICE_VERIFIED=false
STOCK_VERIFIED=false
# Live writes need BOTH --live (or the runner) and this set to exactly "true". Keep false everywhere except the sync server.
ALLOW_LIVE_WRITE=false
# The service role key bypasses RLS: sync server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional: pinged (GET) after each successful live run. Leave empty to disable.
HEALTHCHECK_URL=
# Where --dry-run writes its output and local state (gitignored). Relative paths resolve from the repo root.
SYNC_DATA_DIR=local-data

# Sync runner (scripts/busy-sync/server.mjs) that n8n calls. Token: 24+ random chars, same value in n8n's env.
SYNC_RUNNER_TOKEN=
SYNC_RUNNER_PORT=8787
# 127.0.0.1 when n8n runs on the same host without Docker; the docker bridge IP (e.g. 172.17.0.1) if n8n is in Docker.
SYNC_RUNNER_HOST=127.0.0.1

# Old BUSY Web Service (port 981) — only for the manual tool scripts/busy-query.mjs. The sync no longer uses it.
BUSY_HOST=localhost
BUSY_PORT=981
BUSY_USERNAME=
BUSY_PASSWORD=

# ─── n8n host env (set on the n8n container/process, not in this file) ───
# SYNC_RUNNER_URL=http://127.0.0.1:8787        SYNC_RUNNER_TOKEN=<same as above>
# SITE_URL=https://www.your-domain.in           STALE_ALERT_MINUTES=10
# ALERT_CHANNEL=webhook|email                   ALERT_WEBHOOK_URL=https://… (put {text} in it for GET gateways like CallMeBot)
# ALERT_EMAIL_FROM= ALERT_EMAIL_TO=             ALERT_QUIET_HOURS=21-9   ALERT_REPEAT_MINUTES=0
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false            GENERIC_TIMEZONE=Asia/Kolkata
